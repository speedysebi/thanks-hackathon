# Copy to .env. Everything is optional: with no key the app uses the free keyword extractor.
ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5
EFFORT=low
# $ per million tokens for the cost readout at /api/stats (Opus 5.5 = 4 / 20, Haiku 5.5 = 0.10 / 0.50)
PRICE_IN_PER_M=4
PRICE_OUT_PER_M=20
# Real SMS (Twilio). Leave blank for the local /phone simulator.
TWILIO_AUTH_TOKEN=
PUBLIC_URL=
