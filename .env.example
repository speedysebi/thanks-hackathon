# Copy to .env. Everything is optional: with no key the app uses the free keyword extractor.
ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5
EFFORT=low
# $ per million tokens for the cost readout at /api/stats (Opus 5.5 = 4 / 20, Haiku 5.5 = 0.10 / 0.50)
PRICE_IN_PER_M=4
PRICE_OUT_PER_M=20
# Real SMS (Twilio). Leave blank for the local /phone simulator.
TWILIO_AUTH_TOKEN=
PUBLIC_URL=
# Admin sign-in: name 'admin' + this password (dashboard, report, export, team, console).
# Leave blank and the server makes one up, saves it to data/admin_password.txt and prints it at startup.
# Regular people never need it: anyone can log a note, and accounts for workers are optional.
ADMIN_PASSWORD=
# Admins also need two-step sign-in (a 6-digit code from Google/Microsoft Authenticator etc.).
# Leave blank: the admin scans a QR code at first sign-in (recommended).
# Or set a base32 key here to pre-load it into a shared admin phone. Treat it like the password.
ADMIN_TOTP_SECRET=
# Signs the sign-in cookies. Leave blank and one is made in data/session_secret.txt.
# On hosting where data/ isn't kept between deploys, set this so people stay signed in.
SESSION_SECRET=
